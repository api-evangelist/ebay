          "name": "get Payments Program",
          "request": {
            "name": "get Payments Program",
            "description": {
              "content": "<span class=\"tablenote\"><b>Note:</b> This method is no longer applicable, as all seller accounts globally have been enabled for the new eBay payment and checkout flow.</span><br>This method returns whether or not the user is opted-in to the specified payments program. Sellers opt-in to payments programs by marketplace and you use the <b>marketplace_id</b> path parameter to specify the marketplace of the status flag you want returned.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "payments_program",
                ":marketplace_id",
                ":payments_program_type"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "marketplace_id",
                  "description": "(Required) This path parameter specifies the eBay marketplace of the payments program for which you want to retrieve the seller's status."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "payments_program_type",
                  "description": "(Required) This path parameter specifies the payments program whose status is returned by the call."
