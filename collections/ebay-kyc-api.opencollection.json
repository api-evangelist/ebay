{
  "opencollection": "1.0.0",
  "info": {
    "name": "eBay Account Advertising_eligibility Kyc API",
    "version": "v1.9.2"
  },
  "items": [
    {
      "info": {
        "name": "Kyc",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getKYC",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ebay.com{basePath}/kyc",
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://auth.ebay.com/oauth2/authorize",
              "accessTokenUrl": "https://api.ebay.com/identity/v1/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "<span class=\"tablenote\"><b>Note:</b>This method was originally created to see which onboarding requirements were still pending for sellers being onboarded for eBay managed payments, but now that all seller accounts are onboarded globally, this method should now just returne an empty payload with a <code>204 No Content</code> HTTP status code. </span>"
        }
      ]
    }
  ],
  "bundled": true
}